{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIFR3D Structured Chat Output",
  "type": "object",
  "required": ["summary", "issues", "action_suggestions", "state_update"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_type",
          "severity",
          "summary",
          "why_it_matters",
          "try_first",
          "ignore_for_now",
          "evidence"
        ],
        "properties": {
          "issue_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "summary": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "try_first": { "type": "array", "items": { "type": "string" } },
          "ignore_for_now": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "required": ["metrics", "pointers"],
            "properties": {
              "metrics": { "type": "object" },
              "pointers": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "action_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "payload", "destructive", "requiresSave"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "payload": { "type": "object" },
          "destructive": { "type": "boolean" },
          "requiresSave": { "type": "boolean" }
        }
      }
    },
    "state_update": {
      "type": "object",
      "required": ["focus_tags", "signal_clarity"],
      "properties": {
        "focus_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
